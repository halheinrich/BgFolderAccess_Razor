<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Framework, nullable, implicit usings, warnings-as-errors, and doc-file
       generation are repo-wide policy — see ..\Directory.Build.props. Only
       per-project decisions live here: the Razor SDK (project attribute above),
       the browser SupportedPlatform, and the trim posture below.

       The Razor SDK is used for its static-web-asset pipeline alone — this
       library exposes no .razor components. It exists so folderAccess.js ships
       as a static web asset that consumers import from
       ./_content/BgFolderAccess_Razor/js/folderAccess.js. -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- BgQuiz's WebAssembly client ships this assembly, and its publish runs
       trim analysis with warnings as errors (halheinrich/backgammon#197). The
       library declares itself trim-compatible and runs the analyzer in its own
       build, so a direct trim-unsafe call added here — a reflection-bound
       JsonSerializer overload, say — fails this repo's build
       (TreatWarningsAsErrors) in the change that introduced it. What the
       analyzer cannot see is the wire DTO graph behind an annotated
       InvokeAsync<T>: the annotation keeps T, not the records nested in it,
       and BgQuiz's trimmed publish lost one that way. That class is closed by
       a rule, not a flag — no library type crosses interop as a type argument;
       replies come back as JsonElement and are read through
       BgFolderAccessJsonContext — and BgQuiz's trimmed e2e is the gate for its
       runtime half. Per-project deliberately: the test project is not a
       shipped surface. IsTrimmable, the context's generation mode, and every
       DTO's reachability through the context are pinned by
       BgFolderAccessRazorTrimPostureTests. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only. JsFolderAccess's wire DTOs and BgFolderAccessJsonContext
         are internal (not private) solely so the bUnit module tests can script
         replies by serializing a DTO through the context; nothing outside this
         repo touches them. Grants nothing to consumers. -->
    <InternalsVisibleTo Include="BgFolderAccess_Razor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
